    "b2c9ca42-b6b4-4397-8bf9-634781f64df2": {
      "type": "image-with-text",
      "blocks": {
        "template--17365333049621__b2c9ca42-b6b4-4397-8bf9-634781f64df2-16747870468e373531-0": {
          "type": "heading",
          "settings": {
            "heading": "Giggle Tech",
            "heading_size": "h1"
          }
        },
        "template--17365333049621__b2c9ca42-b6b4-4397-8bf9-634781f64df2-16747870468e373531-1": {
          "type": "text",
          "settings": {
            "text": "<p>At GiggleTech, we believe that virtual reality should be a fun and <br/>joyful experience for everyone. That's why we specialize in creating <br/>easy-to-use accessories that enhance your VR experience.</p><p>Created out of a passion for virtual reality, and a desire to make products that people love to use. <br/><br/>We started GiggleTech because of our passion for virtual reality and a commitment to designing products that people love to use. We want to bridge the gap between Virtual Reality and Real life by crafting novel, cutting edge solutions that innovate in the VR consumer product market.</p><p>We are dedicated to constantly improving and innovating, so your feedback is super important to us.</p><p>Thanks for choosing GiggleTech. We can't wait to be a part of your VR adventures!</p>",
            "text_style": "body"
          }
        },
        "template--17365333049621__b2c9ca42-b6b4-4397-8bf9-634781f64df2-16747870468e373531-2": {
